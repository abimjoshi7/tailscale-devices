[Unit]
Description=Tailscale Device Management API
Documentation=https://github.com/abimjoshi7/tailscale-devices
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=simple
User=tailscale-devices
Group=tailscale-devices

ExecStart=/usr/local/bin/tailscale-devices
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

EnvironmentFile=-/etc/tailscale-devices/env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tailscale-devices

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/tailscale-devices
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
PrivateDevices=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
