# /etc/tailscale-devices/env
# Copy to /etc/tailscale-devices/env and fill in values before starting the service.

# ── Server ────────────────────────────────────────────────────────────────────
LISTEN_PORT=3453
BIND_TAILSCALE=true

# ── Discovery ─────────────────────────────────────────────────────────────────
# Options: Cli | LocalApi | AdminApi
DISCOVERY_MODE=Cli
HEALTH_POLL_SECS=30

# AdminApi mode only:
# TAILSCALE_AUTH_KEY=tskey-api-...
# TAILSCALE_TAILNET=example.com

# ── Security ──────────────────────────────────────────────────────────────────
# Required. At least 16 characters. Comma-separate for key rotation.
API_KEY=CHANGE_ME_use_a_long_random_secret

# Allowlist of commands that can be run via SSH. Defaults shown.
ALLOWED_COMMANDS=uptime,uname,hostname,whoami,id,date,df,free,ps,ss,w,lscpu

# Ports the proxy may forward to. Empty = proxy disabled.
ALLOWED_PROXY_PORTS=

# ── SSH ───────────────────────────────────────────────────────────────────────
SSH_USER=root
# SSH_KNOWN_HOSTS=/var/lib/tailscale-devices/known_hosts

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_COMMAND_TIMEOUT_SECS=60
MAX_PROXY_BODY_BYTES=4194304
SHUTDOWN_TIMEOUT_SECS=30

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: json | (empty for human-readable)
LOG_FORMAT=json
# RUST_LOG=info
